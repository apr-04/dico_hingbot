# ─────────────────────────────────────────────
# 디스코드 봇 설정 (이 파일을 복사해서 .env 로 이름 변경 후 값 채우기)
# ─────────────────────────────────────────────

# 디스코드 개발자 포털 > Bot > Reset Token 에서 발급
DISCORD_TOKEN=여기에_봇_토큰_붙여넣기

# 테스트용 서버 ID (선택)
# 값이 있으면 슬래시 명령어가 그 서버에만 "즉시" 등록됩니다.
# 비워두면 전체 서버에 등록되지만 반영까지 최대 1시간 걸립니다.
# 서버 ID 확인: 디스코드 설정 > 고급 > 개발자 모드 ON > 서버 우클릭 > 서버 ID 복사
GUILD_ID=

# 유튜브 봇 차단 우회용 쿠키 파일 경로 (선택, 처음엔 비워두세요)
# "Sign in to confirm you're not a bot" 에러가 나면 그때 채웁니다.
YTDL_COOKIE_FILE=

# FFmpeg 실행 파일 경로 (선택)
# PATH에 등록돼 있으면 비워두세요. 수동 설치했다면 전체 경로를 적습니다.
# 예: FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe
FFMPEG_PATH=
